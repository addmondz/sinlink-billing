APP_NAME="Sinlink Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_MY

# Leaving email/password blank seeds admin@admin.com / password1234 in local/testing only.
SINLINK_ADMIN_NAME="Shop Administrator"
SINLINK_ADMIN_EMAIL=
SINLINK_ADMIN_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sinlink
DB_USERNAME=sinlink
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=debug
MAIL_MAILER=log
FILESYSTEM_DISK=local
